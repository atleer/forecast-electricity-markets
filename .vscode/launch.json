{
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "justMyCode": false,
            "console": "integratedTerminal",
            "windows": { "python": "${workspaceFolder}/.pixi/envs/default/python.exe" },
            "linux":   { "python": "${workspaceFolder}/.pixi/envs/default/bin/python" }
        },
        {
            "name": "Debug: split test",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/test_split_train_test_val.py", "-s"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "windows": { "python": "${workspaceFolder}/.pixi/envs/default/python.exe" },
            "linux":   { "python": "${workspaceFolder}/.pixi/envs/default/bin/python" }
        },
        {
            "name": "Attach to pixi debugpy",
            "type": "debugpy",
            "request": "attach",
            "connect": {"host": "localhost", "port": 5678},
            "justMyCode": false
        }
    ]
}